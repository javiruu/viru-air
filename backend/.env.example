# Local default (SQLite quick-start)
DB_URL=sqlite:///./viru.db

# Postgres (recommended for local/staging/prod)
# DB_URL=postgresql+psycopg://viru:${DB_PASSWORD}@127.0.0.1:5432/viru

JWT_SECRET=change-me
JWT_ALG=HS256
ACCESS_TOKEN_MINUTES=30
APP_ENV=local
WATCH_REFRESH_COOLDOWN_SECONDS=60
WATCHLIST_STARTUP_REFRESH_ENABLED=true
WATCHLIST_STARTUP_REFRESH_MAX_AGE_SECONDS=14400

# Quick-search shared cache (V2.1)
QUICK_SEARCH_SHARED_CACHE_ENABLED=false
QUICK_SEARCH_SHARED_CACHE_READY_TTL_SECONDS=86400
QUICK_SEARCH_SHARED_CACHE_EMPTY_TTL_SECONDS=7200
QUICK_SEARCH_SHARED_CACHE_DEGRADED_TTL_SECONDS=1800
QUICK_SEARCH_SHARED_CACHE_USE_MEMORY_HOT_LAYER=true

# Fare Memory feature flags (V2.2)
FARE_MEMORY_ENABLED=true
FARE_MEMORY_SEARCH_CACHE_ENABLED=true
FARE_MEMORY_OFFER_CACHE_ENABLED=true
FARE_MEMORY_NEGATIVE_CACHE_ENABLED=true
FARE_MEMORY_BOOT_WARMUP_ENABLED=false
FARE_MEMORY_MAX_BOOT_JOBS=25
FARE_MEMORY_BOOT_WARMUP_JITTER_SECONDS=30
FARE_MEMORY_PROVIDER_RATE_LIMIT_PER_MINUTE=60

# Redis hot layer (optional). Uncomment REDIS_URL to enable Redis as L1
# cache, shared across uvicorn workers. Falls back to in-process dict if
# Redis is unavailable or not configured. See docs/plans/2026-06-10-redis-hot-layer-plan.md
# REDIS_URL=redis://localhost:6379/0
# QUICK_SEARCH_REDIS_TTL_SECONDS=300

DUFFEL_API_KEY=
VUELING_BASE_URL=https://ams.vueling.com
VUELING_PROFILE_ID=e8ffa738-cb67-4a02-b501-9bfd975a4b65
WIZZAIR_BASE_URL=https://be.wizzair.com/29.4.0/Api
WIZZAIR_FARECHART_DAY_INTERVAL=9
EASYJET_BASE_URL=https://www.easyjet.com
EASYJET_FLIGHT_CONNECTIONS_URL=https://flightconnections.easyjet.com
EASYJET_LANGUAGE_CODE=EN
EASYJET_RESIDENCY=ES
# Optional: only if Dohop/easyJet provides a Datadome bypass token for backend access.
EASYJET_FLIGHT_CONNECTIONS_BYPASS_SECRET=
FLIGHT_PROVIDER_ORDER=ryanair,vueling,wizzair,easyjet,duffel
FLIGHT_PROVIDER_RYANAIR_ENABLED=true
FLIGHT_PROVIDER_VUELING_ENABLED=true
FLIGHT_PROVIDER_WIZZAIR_ENABLED=true
FLIGHT_PROVIDER_EASYJET_ENABLED=true
FLIGHT_PROVIDER_DUFFEL_ENABLED=true

# Bootstrap flags (disable in staging/prod once migrations are in use)
RUN_DB_INIT=false
RUN_SEED_USERS=false
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_INTERVAL_SECONDS=60

# === Domain (for stable public access) ===
# Set this to your public hostname so backend CORS can allow same-origin use.
# Example: virutracker.example.com
DOMAIN=

# Optional CORS overrides
# Comma-separated explicit origins (additional to defaults + DOMAIN)
CORS_ALLOW_ORIGINS=
# Regex for dynamic host:port matches
# Set to empty to disable the default regex when DOMAIN is used.
CORS_ALLOW_ORIGIN_REGEX=^https?://45\\.136\\.18\\.49(?::\\d+)?$

# =============================================================================
# Door-to-door providers — Perfil: local_real (default)
# =============================================================================
#
# Este bloque usa el perfil "local_real": desarrollo diario con providers
# reales parciales. Deeplinks funcionan sin API key. GTFS con feeds open data
# verificados (MOM Treviso, ACTV Venice). Sin Google Routes/Places (requieren
# GOOGLE_MAPS_API_KEY). Sin scrapers. Sin mock.
#
# Perfiles canónicos documentados en:
#   docs/runbooks/runbook-activation-profiles.md
#
# Para cambiar a otro perfil, ajusta las flags DOOR_TO_DOOR_* según la matriz.
#
# ---------------------------------------------------------------------------
# local_demo (demostración sin providers reales):
#   DOOR_TO_DOOR_ENABLE_MOCK_PROVIDER=true
#   DOOR_TO_DOOR_ENABLE_REAL_PROVIDERS=false
#   DOOR_TO_DOOR_ENABLE_GTFS_TRANSIT=false
#   DOOR_TO_DOOR_ENABLE_GOOGLE_ROUTES=false
#   DOOR_TO_DOOR_ENABLE_GOOGLE_PLACES=false
#
# staging_safe (pre-prod con APIs reales):
#   DOOR_TO_DOOR_ENABLE_MOCK_PROVIDER=false
#   DOOR_TO_DOOR_ENABLE_REAL_PROVIDERS=true
#   DOOR_TO_DOOR_ENABLE_GTFS_TRANSIT=true
#   DOOR_TO_DOOR_ENABLE_GOOGLE_ROUTES=true      # + GOOGLE_MAPS_API_KEY
#   DOOR_TO_DOOR_ENABLE_GOOGLE_PLACES=true      # + GOOGLE_MAPS_API_KEY
#
# prod_gradual (producción con rollout controlado):
#   DOOR_TO_DOOR_ENABLE_MOCK_PROVIDER=false      # bloqueado
#   DOOR_TO_DOOR_ENABLE_REAL_PROVIDERS=true
#   DOOR_TO_DOOR_ENABLE_GTFS_TRANSIT=true
#   DOOR_TO_DOOR_ENABLE_GOOGLE_ROUTES=true       # + GOOGLE_MAPS_API_KEY
#   DOOR_TO_DOOR_ENABLE_GOOGLE_PLACES=true       # + GOOGLE_MAPS_API_KEY
#   DOOR_TO_DOOR_ENABLE_SCRAPERS=false           # bloqueado
# ---------------------------------------------------------------------------

DOOR_TO_DOOR_ENABLE_MOCK_PROVIDER=false
DOOR_TO_DOOR_ENABLE_REAL_PROVIDERS=true
DOOR_TO_DOOR_ENABLE_SCRAPERS=false
DOOR_TO_DOOR_ENABLE_GOOGLE_ROUTES=false
DOOR_TO_DOOR_ENABLE_GOOGLE_PLACES=false
DOOR_TO_DOOR_ENABLE_NOMINATIM_SUGGESTIONS=true
DOOR_TO_DOOR_NOMINATIM_TIMEOUT_SECONDS=3.5
DOOR_TO_DOOR_NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search

# GTFS transit provider (activo por defecto con feeds open data verificados)
DOOR_TO_DOOR_ENABLE_GTFS_TRANSIT=true
DOOR_TO_DOOR_GTFS_CACHE_DIR=.gtfs_cache
DOOR_TO_DOOR_GTFS_CACHE_TTL_SECONDS=86400
DOOR_TO_DOOR_GTFS_MAX_WALK_RADIUS_METERS=2000
DOOR_TO_DOOR_GTFS_MAX_RESULTS=3
# NAP Spain API key for downloading GTFS feeds from nap.transportes.gob.es
# Register at nap.transportes.gob.es → Account/InstruccionesAPI to get your key.
# This unlocks EMT Málaga (urban bus to AGP) and CTAN Andalucía (regional feeds).
GTFS_NAP_API_KEY=
# Google Maps Platform API key (shared by Google Routes and Google Places)
# Required for the staging_safe and prod_gradual profiles (see runbook-activation-profiles.md).
# Get your key at https://console.cloud.google.com/google/maps-apis/credentials
# Enable: Routes API (for distances/durations) and Places API (for suggestions).
GOOGLE_MAPS_API_KEY=
# Navitia public transport API (navitia.io)
# Register at navitia.io to get your API key (free tier available).
# Covers Spain, Italy, and other European regions with real transit schedules.
NAVITIA_API_KEY=
DOOR_TO_DOOR_ENABLE_NAVITIA=false
DOOR_TO_DOOR_NAVITIA_TIMEOUT_SECONDS=8
# GTFS feeds: inline JSON string or path to manifest file
# Option A - JSON inline:
# DOOR_TO_DOOR_GTFS_FEEDS_JSON=[{"id":"ctan_andalucia","name":"Consorcios Transporte Andalucia","region":"andalucia","url":"https://..."}]
# Option B - manifest file (recommended for local/dev):
DOOR_TO_DOOR_GTFS_FEEDS_FILE=backend/app/door_to_door/providers/gtfs_feeds.json
# If neither is set, the provider auto-discovers providers/gtfs_feeds.json
DOOR_TO_DOOR_GTFS_FEEDS_JSON=

# === Hotels ===
# /hoteles remains readable if data already exists.
# HOTEL_FEATURE_ENABLED only gates provider-backed ingestion and sweeps.
# Provider: mock (fixtures) or makcorps (real API)
HOTEL_PROVIDER=mock
HOTEL_FEATURE_ENABLED=false
HOTEL_SWEEP_ENABLED=false
HOTEL_SWEEP_INTERVAL_SECONDS=3600
HOTEL_PROVIDER_TIMEOUT_SECONDS=10
HOTEL_PROVIDER_MAX_RETRIES=2
# Reserved for a future provider-response cache. No runtime cache is active yet.
HOTEL_PROVIDER_CACHE_TTL_SECONDS=3600
HOTEL_GEOCODER_ENABLED=true

# Makcorps (real hotel pricing intelligence API)
# HOTEL_PROVIDER=makcorps requires MAKCORPS_API_KEY
# Current pilot uses the fixed /v1/hotels/pricing endpoint.
MAKCORPS_API_KEY=
MAKCORPS_BASE_URL=https://api.makcorps.com
