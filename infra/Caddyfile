# Caddy reverse proxy for viru-tracker on native Windows.
# Usage: set DOMAIN env var, e.g. DOMAIN=virutracker.duckdns.org
# Caddy auto-provisions TLS via Let's Encrypt when a valid public domain is used.
#
# For stable public domains, pair Caddy with DuckDNS + the local updater task.
# Frontend and backend run as normal local processes on ports 3000/8000.

{$DOMAIN:localhost} {
	# Backend (FastAPI)
	reverse_proxy /api/* 127.0.0.1:8000

	# Frontend (Next.js)
	reverse_proxy /* 127.0.0.1:3000

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Gzip
	encode gzip zstd

	log {
		output stdout
		format json
	}
}
