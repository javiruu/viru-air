# viru-tracker - DuckDNS local config template
# Copy values into infra/duckdns.local.env or run scripts/setup-duckdns.ps1

DUCKDNS_DOMAIN=virutracker
DUCKDNS_FQDN=virutracker.duckdns.org
DUCKDNS_TOKEN=replace-with-your-duckdns-token
DUCKDNS_UPDATE_URL=https://www.duckdns.org/update?domains=virutracker&token=replace-with-your-duckdns-token&ip=
DUCKDNS_LOG_PATH=logs/duckdns-update.log
DUCKDNS_TASK_NAME=ViruTracker-DuckDNS
