# viru-tracker — Production environment template
# Copy this to .env and fill in your values.

# === Domain ===
# Replace with your public hostname.
# Example: virutracker.example.com
DOMAIN=your-domain.example.com

# === Frontend ===
# In production with a same-domain tunnel or reverse proxy, the API is served on the same domain.
NEXT_PUBLIC_API_URL=/api/v1

# === Backend CORS ===
# Comma-separated additional origins (optional).
# Defaults already include localhost and the server IPs.
# Add your domain if needed (though a same-domain tunnel means
# same-origin requests don't need CORS).
# CORS_ALLOW_ORIGINS=https://your-domain.example.com

# Regex for dynamic CORS matching (optional).
# CORS_ALLOW_ORIGIN_REGEX=

# === Backend secrets ===
JWT_SECRET=change-me-to-a-strong-random-value
APP_ENV=production
