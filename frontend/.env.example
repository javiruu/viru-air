[TEMPLATE]
# API base URL for the frontend.
# In development with the Next.js proxy: /api/v1 (rewritten to NEXT_PUBLIC_LOCAL_API_ORIGIN).
# In production behind a same-domain tunnel or reverse proxy: /api/v1 (same-origin).
# For a separate API domain, set the full URL: https://api.your-domain.com/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Local API origin (used by Next.js rewrites in development).
# Default: http://127.0.0.1:8000. Override when the backend runs on another port
# (e.g. 8001 when 8000 is taken) — see docs/runbooks/runbook-supabase-native.md.
NEXT_PUBLIC_LOCAL_API_ORIGIN=http://127.0.0.1:8000

# Server-side (SSR/RSC) fetch base. Must match NEXT_PUBLIC_LOCAL_API_ORIGIN
# when the port is overridden.
# INTERNAL_API_URL=http://127.0.0.1:8001/api/v1

# Supabase Auth (required for login/register). Without these the client falls
# back to a mock project that CANNOT authenticate — login will fail.
#
# Hosted project: copy both values from your Supabase dashboard
# (Project Settings → API). The frontend URL must equal the backend SUPABASE_URL:
# tokens are only verified against the same project.
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[PUBLISHABLE-ANON-KEY]
#
# Auth model note: hosted projects using the new key system (sb_publishable_...)
# sign JWTs with asymmetric ES256 keys — there is no HS256 secret to share.
# The backend verifies tokens via the project public JWKS (see backend/.env.example
# and docs/runbooks/runbook-supabase-native.md).
#
# Copy this file to frontend/.env.local and fill in the real values.

# Public hostname used for OG tags, emails, etc.
# Example: viru-air.example.com
# NEXT_PUBLIC_SITE_URL=https://viru-air.example.com
