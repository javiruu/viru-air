[TEMPLATE]
# API base URL for the frontend.
# In development with the Next.js proxy: /api/v1 (rewritten to 127.0.0.1:8000).
# In production behind Caddy/nginx on the same domain: /api/v1 (same-origin).
# For a separate API domain, set the full URL: https://api.your-domain.com/api/v1
NEXT_PUBLIC_API_URL=/api/v1

# Local API origin (used by Next.js rewrites in development).
NEXT_PUBLIC_LOCAL_API_ORIGIN=http://127.0.0.1:8000

# Custom domain (e.g. DuckDNS). Used for OG tags, emails, etc.
# Example: virutracker.duckdns.org
# NEXT_PUBLIC_SITE_URL=https://virutracker.duckdns.org
