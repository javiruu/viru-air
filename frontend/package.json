{
  "name": "viru-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/strip_framer_motion_sourcemaps.mjs",
    "predev": "node scripts/strip_framer_motion_sourcemaps.mjs",
    "prebuild": "node scripts/strip_framer_motion_sourcemaps.mjs",
    "dev": "node scripts/dev-server.mjs",
    "dev:warm": "node scripts/dev-server.mjs --warmup=fast",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test",
    "test:e2e:quick-search": "tsx --test tests/quick-search-relax-preview.e2e.test.ts",
    "qa:visual:quick-search": "node scripts/qa_quick_search_visual.mjs",
    "styles:verify": "node scripts/verify-screen-styles.mjs",
    "bones:build": "boneyard-js build",
    "update:airports": "node ./scripts/update_airports_iata.mjs",
    "doctor": "npx react-doctor@latest",
    "test:e2e": "playwright test",
    "lint:biome": "biome lint",
    "format:biome": "biome format",
    "check:biome": "biome check",
    "typecheck": "tsc --noEmit",
    "api:generate": "orval",
    "api:check": "orval && git diff --exit-code src/api/generated"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@tanstack/react-query": "^5.102.8",
    "boneyard-js": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "maplibre-gl": "6.9.0",
    "next": "15.5.25",
    "postcss": "8.5.25",
    "posthog-js": "^1.430.2",
    "radix-ui": "^1.6.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.59.1",
    "@types/node": "22.10.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "orval": "^8.32.0",
    "playwright": "^1.59.1",
    "react-doctor": "^0.9.11",
    "tsx": "4.23.13",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
