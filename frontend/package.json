{
  "name": "viru-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/strip_framer_motion_sourcemaps.mjs",
    "predev": "node scripts/strip_framer_motion_sourcemaps.mjs",
    "prebuild": "node scripts/strip_framer_motion_sourcemaps.mjs",
    "dev": "node scripts/dev-server.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "tsx --test",
    "test:e2e:quick-search": "tsx --test tests/quick-search-relax-preview.e2e.test.ts",
    "qa:visual:quick-search": "node scripts/qa_quick_search_visual.mjs",
    "bones:build": "boneyard-js build",
    "update:airports": "node ./scripts/update_airports_iata.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "boneyard-js": "^1.9.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.8.0",
    "maplibre-gl": "^5.24.0",
    "next": "15.5.22",
    "postcss": "8.5.25",
    "radix-ui": "^1.6.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.22",
    "playwright": "^1.59.1",
    "react-doctor": "^0.9.11",
    "tsx": "^4.20.0",
    "typescript": "5.7.2"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
